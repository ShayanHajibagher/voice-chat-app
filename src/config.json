{
  "language": "fa",
  "stt_backend": "whisper",
  "whisper_model": "turbo",
  "languages": {
    "en": {
      "vosk_model_path": "vosk-model-small-en-us-0.15",
      "model_path": "en_US-lessac-high.onnx",
      "config_path": "en_US-lessac-high.onnx.json"
    },
    "fa": {
      "vosk_model_path": "vosk-model-small-fa-rhasspy-0.15",
